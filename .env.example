# EmailJS — chiavi del modulo di contatto.
# Copiate questo file in `.env.local` e riempite i tre valori.
#
# Sono pubbliche per costruzione: EmailJS invia dal browser, quindi
# finiscono comunque nel codice servito al visitatore. Non sono un
# segreto da proteggere — gli abusi si fermano dal pannello EmailJS,
# limitando i domini da cui è consentito inviare.
#
# Dove si trovano, su https://dashboard.emailjs.com:
#   SERVICE_ID  → Email Services, dopo aver collegato la casella
#   TEMPLATE_ID → Email Templates, dentro il modello creato
#   PUBLIC_KEY  → Account › General
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
